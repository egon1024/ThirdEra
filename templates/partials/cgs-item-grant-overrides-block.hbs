<section class="cgs-item-grant-overrides-block form-group">
  <h3 class="form-header" title="{{localize 'THIRDERA.CGS.GrantOverridesHintTitle'}}">{{localize "THIRDERA.CGS.GrantOverridesSection"}}</h3>
  <p class="notes">{{localize "THIRDERA.CGS.GrantOverridesHint"}}</p>
  {{#if cgsTemplateUi}}
  <div class="cgs-template-link-panel form-fields flexcol">
    <p class="cgs-template-link-status">{{cgsTemplateUi.statusLine}}</p>
    {{#if cgsTemplateUi.effectiveUuid}}
    {{#unless cgsTemplateUi.broken}}
    <p class="notes cgs-template-link-origin">
      {{localize "THIRDERA.CGS.TemplateLinkOriginLabel"}}:
      <strong>{{cgsTemplateUi.templateDisplayName}}</strong>
      {{#if cgsTemplateUi.originText}}<span class="cgs-template-link-pack"> ({{cgsTemplateUi.originText}})</span>{{/if}}
    </p>
    {{/unless}}
    {{/if}}
    {{#if editable}}
    <div class="flexrow cgs-template-link-actions" style="flex-wrap: wrap; gap: 0.35em;">
      <button type="button" class="button" data-action="pickCgsTemplateItem" title="{{localize 'THIRDERA.CGS.TemplateLinkPickTooltip'}}">
        {{localize "THIRDERA.CGS.TemplateLinkPickButton"}}
      </button>
      {{#if (or cgsTemplateUi.explicitUuid cgsTemplateUi.conflict)}}
      <button type="button" class="button" data-action="clearCgsTemplateUuid" title="{{localize 'THIRDERA.CGS.TemplateLinkClearExplicitTooltip'}}">
        {{localize "THIRDERA.CGS.TemplateLinkClearExplicit"}}
      </button>
      {{/if}}
    </div>
    <div class="cgs-template-drop-zone form-group" data-cgs-template-drop data-tooltip="{{localize 'THIRDERA.CGS.TemplateLinkDropHint'}}">
      <label class="cgs-template-drop-label">{{localize "THIRDERA.CGS.TemplateLinkDropHint"}}</label>
    </div>
    {{/if}}
  </div>
  {{/if}}
  {{> "systems/thirdera/templates/partials/cgs-mechanics-senses-override.hbs"}}
  {{> "systems/thirdera/templates/partials/cgs-mechanics-spell-grants-override.hbs"}}
  {{> "systems/thirdera/templates/partials/cgs-mechanics-typed-defenses-override.hbs"}}
  {{> "systems/thirdera/templates/partials/cgs-mechanics-type-overlays-override.hbs"}}
  {{#if editable}}
  <div class="cgs-grant-overrides-actions">
    <button type="button" class="button" data-action="resetCgsGrantOverrides" title="{{localize 'THIRDERA.CGS.ResetOverridesTooltip'}}">
      {{localize "THIRDERA.CGS.ResetOverrides"}}
    </button>
  </div>
  {{/if}}
</section>
